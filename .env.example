# Server-only. NEVER prefix Tripo or Firebase Admin secrets with NEXT_PUBLIC_.
TRIPO_API_KEY=
# Set to 1 to generate a clearly labeled fake cube GLB when no live key is used.
MOCK_TRIPO=0

# HMAC for session cookies (required in production when using login).
SESSION_SECRET=

# Optional: only this email may create a session.
ADMIN_EMAIL=

# Dev-only. Ignored when NODE_ENV=production. Shows a huge banner.
DEV_AUTH_BYPASS=0

# Firebase client (public identifiers — still not secrets you invent; paste from your project).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server). Required for Firestore/Storage persistence.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
